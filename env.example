# Token bot dari Discord Developer Portal
DISCORD_TOKEN=

# Opsional: isi Guild ID server testing kamu supaya slash command
# langsung muncul instan (tanpa nunggu propagasi global ~1 jam)
GUILD_ID=

# Prefix untuk command klasik (selain slash command), contoh: n!joinleave builder join
PREFIX=n!

# Branding embed yang dikirim ke applicant lewat DM setelah selesai isi form aplikasi.
# Kosongin aja kalau gak mau tombolnya muncul (embed tetap tampil, cuma tanpa tombol itu).
BOT_INVITE_URL=
SUPPORT_SERVER_URL=
BOT_BANNER_URL=
